    "def make_model(r_b, r_iz, rho_b, rho_iz, rho_f):\n",
    "    return np.r_[r_b, r_iz - r_b, np.log(rho_b), np.log(rho_iz), np.log(rho_f)]\n",
    "\n",
    "def compute_dbdt(model_vec):\n",
    "    b = simulation_parametric.dpred(model_vec)\n",
