    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.constants import mu_0\n",
    "h1_base = 10.0      # мощность первого слоя (м)\n",
    "rho1_base = 10.0    # УЭС первого слоя (Ом·м)\n",
    "h2_base = 5.0       # мощность второго слоя (м)\n",
    "rho2_base = 50.0    # УЭС второго слоя (Ом·м)\n",
    "rho3_base = 10.0    # УЭС третьего слоя (Ом·м)\n",
    "\n",
    "times = np.logspace(-5, -2, 31) \n",
    "times_mid = (times[:-1] + times[1:]) / 2 \n",
    "\n",
    "def make_3layer_model(h1, rho1, h2, rho2, rho3):\n",
    "    return np.r_[h1, h2, np.log(rho1), np.log(rho2), np.log(rho3)]\n",
    "\n",
    "def forward_response_3layer(model_vec, times):\n",
    "    \"\"\"\n",
    "    Упрощенный расчет отклика для 3-слойной модели\n",
    "    \"\"\"\n",
    "    h1, h2 = model_vec[0], model_vec[1]\n",
    "    rho1, rho2, rho3 = np.exp(model_vec[2]), np.exp(model_vec[3]), np.exp(model_vec[4])\n",
    "    \n",
    "    sigma1, sigma2, sigma3 = 1/rho1, 1/rho2, 1/rho3\n",
    "    \n",
    "    dbdt = np.zeros(len(times))\n",
    "    \n",
    "    for i, t in enumerate(times):\n",
    "        if t < 1e-4:\n",
    "            rho_eff = rho1\n",
    "        elif t < 5e-4:\n",
    "            rho_eff = (rho1 * h1 + rho2 * min(h2, 5)) / (h1 + min(h2, 5))\n",
    "        else:\n",
    "            rho_eff = (rho1 * h1 + rho2 * h2 + rho3 * 10) / (h1 + h2 + 10)\n",
    "        \n",
    "        # Аппроксимация спада сигнала\n",
    "        dbdt[i] = 1e-6 * (t / 1e-4)**(-1.5) * np.exp(-t * rho_eff / 100)\n",
    "    \n",
    "    return dbdt\n",
    "\n",
    "def calculate_misfits(d_obs, d_calc):\n",
    "    # Относительная невязка\n",
    "    phi_rel = np.sqrt(np.sum(((d_calc - d_obs) / d_obs)**2))\n",
    "    \n",
    "    # Логарифмическая невязка\n",
    "    phi_log = np.sqrt(np.sum((np.log10(np.abs(d_calc)) - np.log10(np.abs(d_obs)))**2))\n",
    "    \n",
    "    return phi_rel, phi_log\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"РАСЧЕТ ЧУВСТВИТЕЛЬНОСТИ МЕТОДИК НЕВЯЗКИ\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# 1. Опорная модель\n",
    "model_base = make_3layer_model(h1_base, rho1_base, h2_base, rho2_base, rho3_base)\n",
    "d_obs = forward_response_3layer(model_base, times)\n",
    "\n",
    "print(f\"\\nОПОРНАЯ МОДЕЛЬ:\")\n",
    "print(f\"  h1 = {h1_base} м, ρ1 = {rho1_base} Ом·м\")\n",
    "print(f\"  h2 = {h2_base} м, ρ2 = {rho2_base} Ом·м\")\n",
    "print(f\"  ρ3 = {rho3_base} Ом·м\")\n",
    "\n",
    "variations = [\n",
    "    {\"name\": \"Увеличение h1 на 20%\", \"h1\": 12.0, \"rho1\": rho1_base, \"h2\": h2_base, \"rho2\": rho2_base, \"rho3\": rho3_base},\n",
    "    {\"name\": \"Увеличение h1 на 50%\", \"h1\": 15.0, \"rho1\": rho1_base, \"h2\": h2_base, \"rho2\": rho2_base, \"rho3\": rho3_base},\n",
    "    {\"name\": \"Увеличение ρ2 на 20%\", \"h1\": h1_base, \"rho1\": rho1_base, \"h2\": h2_base, \"rho2\": 60.0, \"rho3\": rho3_base},\n",
    "    {\"name\": \"Увеличение ρ2 на 100%\", \"h1\": h1_base, \"rho1\": rho1_base, \"h2\": h2_base, \"rho2\": 100.0, \"rho3\": rho3_base},\n",
    "    {\"name\": \"Увеличение h2 на 40%\", \"h1\": h1_base, \"rho1\": rho1_base, \"h2\": 7.0, \"rho2\": rho2_base, \"rho3\": rho3_base},\n",
    "    {\"name\": \"Увеличение ρ1 на 50%\", \"h1\": h1_base, \"rho1\": 15.0, \"h2\": h2_base, \"rho2\": rho2_base, \"rho3\": rho3_base},\n",
    "]\n",
    "\n",
    "results = []\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"РЕЗУЛЬТАТЫ РАСЧЕТА НЕВЯЗОК\")\n",
    "print(\"=\"*60)\n",
    "print(f\"{'Вариация':<35} {'Φ_rel':<12} {'Φ_log':<12}\")\n",
    "print(\"-\"*60)\n",
    "\n",
    "for var in variations:\n",
    "    model_var = make_3layer_model(var[\"h1\"], var[\"rho1\"], var[\"h2\"], var[\"rho2\"], var[\"rho3\"])\n",
    "    d_calc = forward_response_3layer(model_var, times)\n",
    "    \n",
    "    phi_rel, phi_log = calculate_misfits(d_obs, d_calc)\n",
    "    \n",
    "    results.append({\n",
    "        \"name\": var[\"name\"],\n",
    "        \"phi_rel\": phi_rel,\n",
    "        \"phi_log\": phi_log,\n",
    "        \"d_calc\": d_calc\n",
    "    })\n",
    "    \n",
    "    print(f\"{var['name']:<35} {phi_rel:<12.4f} {phi_log:<12.4f}\")\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "ax = axes[0, 0]\n",
    "ax.semilogy(times, np.abs(d_obs), 'k-', linewidth=2.5, label='Опорная модель')\n",
    "ax.set_xlabel('Время (с)', fontsize=11)\n",
    "ax.set_ylabel('|dB/dt| (В/м²)', fontsize=11)\n",
    "ax.set_title('Сигнал опорной модели', fontsize=12, fontweight='bold')\n",
    "ax.grid(True, which='both', alpha=0.3)\n",
    "ax.legend()\n",
