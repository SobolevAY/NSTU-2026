    "\n",
    "    # базовая кривая\n",
    "    ax.semilogy(times_mid, np.abs(dbdt_base), \"k--\", lw=2.5, label=\"Базовая\")\n",
    "\n",
    "    ax.set_xlabel(\"Время (с)\")\n",
    "    ax.set_ylabel(\"|dB/dt| (Тл/с)\")\n",
    "    ax.set_title(title)\n",
    "    ax.grid(True, which=\"both\", alpha=0.4)\n",
    "    ax.legend(title=unit, fontsize=7, title_fontsize=8,\n",
